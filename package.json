{
  "name": "offtap",
  "version": "0.1.0",
  "description": "Hausa USSD and voice Lightning payments over Nostr Wallet Connect",
  "scripts": {
    "test": "vitest run",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/formbody": "^9.0.2",
    "@getalby/lightning-tools": "^10.0.0",
    "@getalby/sdk": "^9.0.0",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
