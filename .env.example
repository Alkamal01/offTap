PORT=3000

# Public address of this server, used in the wallet-link SMS.
PUBLIC_URL=http://localhost:3000

# Africa's Talking. Leave empty to run with the built-in phone simulator at /sim.
# Use AT_USERNAME=sandbox with a sandbox API key for the Africa's Talking simulator.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
USSD_CODE=*384*8822#

# If set, the callback URLs become /ussd/<token> and /voice/<token>. Recommended in production.
USSD_WEBHOOK_TOKEN=

# Limits in sats, enforced by the server on top of the budget set in the wallet.
MAX_PAYMENT_SATS=50000
DAILY_LIMIT_SATS=100000

# Where wallets come from when someone signs up over USSD.
#   faucet  - test wallets with test sats from faucet.nwc.dev (default, no real value)
#   albyhub - isolated sub-wallets on your own Alby Hub (real sats)
#   none    - no sign-up; users must link their own wallet
WALLET_PROVIDER=faucet
FAUCET_SATS=10000

# Demo traders with test wallets are created on first start when the simulator is on
# and WALLET_PROVIDER=faucet. Set to false to start empty.
SEED_DEMO=
ALBY_HUB_URL=http://localhost:8080/api
ALBY_HUB_TOKEN=

# Speech-to-text for voice. Leave both empty to use typed sentences in the simulator.
# Easiest: a Groq API key (console.groq.com), which uses their hosted Whisper large v3.
GROQ_API_KEY=
# Or self-host: any server with the OpenAI transcription API, for example
#   docker compose --profile voice up   then   STT_URL=http://speech:8000/v1/audio/transcriptions
STT_URL=
STT_API_KEY=
STT_MODEL=

# Secret mixed into PIN encryption. Generated into the data folder if left empty.
SERVER_SECRET=

# Only for the developer CLI (npm run cli). Never commit a real value.
NWC_URI=
