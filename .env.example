PORT=3000

# Public address of this server, used in the wallet-link SMS.
PUBLIC_URL=http://localhost:3000

# Africa's Talking. Leave empty to run with the built-in phone simulator at /sim.
# Use AT_USERNAME=sandbox with a sandbox API key for the Africa's Talking simulator.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
USSD_CODE=*384*8822#

# If set, the USSD callback URL becomes /ussd/<token>. Recommended in production.
USSD_WEBHOOK_TOKEN=

# Limits in sats, enforced by the server on top of the budget set in the wallet.
MAX_PAYMENT_SATS=50000
DAILY_LIMIT_SATS=100000

# Secret mixed into PIN encryption. Generated into the data folder if left empty.
SERVER_SECRET=

# Only for the developer CLI (npm run cli). Never commit a real value.
NWC_URI=
