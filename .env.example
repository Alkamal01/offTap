# HTTP port for the offTap server
PORT=3000

# NWC connection string, used only by the CLI (`npm run cli`) for local testing.
# Create it in your wallet (e.g. Alby Hub) limited to pay_invoice + get_balance
# with a small daily budget. Never commit the real value.
NWC_URI=

# Largest single payment offTap will attempt, in sats (server-side safety cap,
# on top of the budget you set in the wallet itself).
MAX_PAYMENT_SATS=50000
